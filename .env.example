# Toponymy API Keys Configuration
# Copy this file to .env and fill in your actual API keys
# Never commit the .env file to version control!

# Cohere API Key (for CohereEmbedder and CohereNamer)
COHERE_API_KEY=your-cohere-api-key-here
# Legacy (deprecated - use COHERE_API_KEY instead):
# CO_API_KEY=your-cohere-api-key-here

# OpenAI API Key (for OpenAIEmbedder and OpenAINamer)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for AnthropicEmbedder and AnthropicNamer)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Microsoft Azure AI (for AzureAIEmbedder and AzureAINamer)
AZURE_AI_API_KEY=your-azure-ai-api-key-here
AZURE_AI_API_BASE=your-azure-ai-api-base-here
# Legacy (deprecated - use AZURE_AI_* instead):
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_ENDPOINT=your-azure-endpoint-here

# Mistral API Key (for MistralEmbedder)
MISTRAL_API_KEY=your-mistral-api-key-here

# Voyage AI API Key (for VoyageAIEmbedder)
VOYAGEAI_API_KEY=your-voyageai-api-key-here

# Google Gemini API Key (for GoogleGeminiNamer)
GEMINI_API_KEY=your-gemini-api-key-here
# Legacy (deprecated - use GEMINI_API_KEY instead):
# GOOGLE_API_KEY=your-google-api-key-here
